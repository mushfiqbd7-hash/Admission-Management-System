# Docker Production Environment
# Copy to .env and fill in real values before running docker-compose up

DB_PASSWORD=change_this_strong_password
DB_NAME=sams_db
DB_USER=sams_user

JWT_SECRET=change_this_to_a_very_long_random_secret_min_32_chars
JWT_EXPIRES_IN=8h

CLIENT_URL=http://localhost
PORT=5000
NODE_ENV=production

UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
