# ─── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────
DATABASE_URL=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=sams_db
DB_USER=sams_user
DB_PASSWORD=your_database_password_here

# ─── JWT Auth ─────────────────────────────────────────────
JWT_SECRET=replace_with_a_real_very_long_secret_only_in_real_env
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# ─── File Uploads ─────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ─── CORS ─────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200